DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pgboss

PGBOSS_DASHBOARD_JWT_SECRET=replace-with-random-secret

AUTH_SCHEMA=auth
AUTH_REGISTRATION_API_KEY=replace-with-long-random-api-key
AUTH_REGISTRATION_BULK_MAX_SIZE=100
AUTH_REGISTRATION_RATE_LIMIT_MAX_REQUESTS=10
AUTH_REGISTRATION_RATE_LIMIT_WINDOW_MS=60000

AUTH_DEFAULT_USER_FORCE_RESET=false
AUTH_DEFAULT_USER_ENABLED=false
AUTH_DEFAULT_USER_EMAIL=admin@example.com
AUTH_DEFAULT_USER_PASSWORD=replace-with-strong-password