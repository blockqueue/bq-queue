{
  "name": "queue-service",
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "nodemon",
    "build": "rm -rf dist && tsc",
    "start": "node ./dist/index.js",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "db:generate:migration": "NODE_OPTIONS='--import tsx' drizzle-kit generate --config=drizzle.config.ts",
    "db:apply:migration": "tsx src/db/migrate.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cron-parser": "^4.9.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "js-yaml": "^4.1.1",
    "pino": "^10.1.0",
    "postgres": "^3.4.8",
    "pg-boss": "^12.14.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/express": "^5.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.9",
    "nodemon": "^3.1.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
